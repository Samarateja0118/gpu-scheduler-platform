   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "modelserver:error_ratio:rate5m",
     "legendFormat": "{{track}} 5m",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
