    },
    {
     "refId": "B",
     "expr": "sum by (track) (rate(modelserver_requests_total{code=~\"5..\"}[1m])) / sum by (track) (rate(modelserver_requests_total[1m]))",
     "legendFormat": "{{track}} 1m",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "p95 latency by track",
   "gridPos": {
    "x": 16,
    "y": 30,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (track, le) (rate(modelserver_request_duration_seconds_bucket[1m])))",
