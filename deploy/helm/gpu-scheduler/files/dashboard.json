{
 "uid": "gpu-scheduler",
 "title": "GPU Scheduler Platform",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Scheduler",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "GPU allocation",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(gpusched_gpus_allocated) / sum(gpusched_gpus_total)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Pending jobs",
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(gpusched_pending_jobs)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Nodes not ready",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "gpusched_nodes{state=\"not_ready\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Preemptions (1h)",
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(gpusched_preemptions_total[1h]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "GPUs allocated by type",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "gpusched_gpus_allocated",
     "legendFormat": "{{gpu_type}} allocated",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "gpusched_gpus_total",
     "legendFormat": "{{gpu_type}} total",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Pending jobs by priority class",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "gpusched_pending_jobs",
     "legendFormat": "{{class}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Queue wait p95 by class",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (class, le) (rate(gpusched_queue_wait_seconds_bucket[5m])))",
     "legendFormat": "{{class}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Preemptions per minute by tenant",
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tenant) (rate(gpusched_preemptions_total[5m])) * 60",
     "legendFormat": "{{tenant}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Tenant GPUs in use vs guarantee",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "gpusched_tenant_gpus_in_use",
     "legendFormat": "{{tenant}} in use",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "gpusched_tenant_gpus_guaranteed",
     "legendFormat": "{{tenant}} guaranteed",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Scheduling pass p99 / intake depth",
   "gridPos": {
    "x": 12,
    "y": 21,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(gpusched_schedule_cycle_seconds_bucket[5m])))",
     "legendFormat": "cycle p99 (s)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "gpusched_intake_queue_depth",
     "legendFormat": "intake depth",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 12,
   "type": "row",
   "title": "Model serving",
   "gridPos": {
    "x": 0,
    "y": 29,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Requests per second by track",
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (track) (rate(modelserver_requests_total[1m]))",
